# ==============================================================================
# CARBONREADY ENVIRONMENT CONFIGURATION TEMPLATE
# AI Carbon Compliance Copilot for MSME Exporters
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NUGEN DOMAIN-ALIGNED AI INFERENCE (MANDATORY SPONSOR REQUIREMENT)
# Official Documentation: https://docs.nugen.in/
# Endpoint: https://api.nugen.in/api/v3/inference/chat/completions
# ------------------------------------------------------------------------------
# Your official Nugen API key obtained from https://console.nugen.in/
NUGEN_API_KEY=

# The deployed identifier for your domain-aligned CarbonReady model
# Example: nugen-carbonready-v1 or your custom fine-tuned model ID
NUGEN_ALIGNED_MODEL_ID=

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI SPEECH TRANSCRIPTION (OPTIONAL SPEECH-TO-TEXT ADAPTER)
# Official Documentation: https://ai.google.dev/
# Model: gemini-3.5-transcribe
# Strictly responsible ONLY for verbatim audio transcription (mr-IN, hi-IN, en-IN).
# Domain extraction & carbon reasoning remain strictly handled by Nugen AI.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & AUTHENTICATION (OPTIONAL CLOUD PERSISTENCE)
# If left blank, CarbonReady operates in high-fidelity local demo persistence mode
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

